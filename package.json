{
  "name": "fr-fantasy",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "prebuild": "npm run participants:check",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test",
    "import:h2h-calendar": "node scripts/import-h2h-calendar.mjs",
    "import:retro": "node scripts/import-retro-tournaments.mjs",
    "import:archive-cup": "node scripts/import-king-cup-2024.mjs",
    "capture:season-2025": "node scripts/season-regression.mjs capture",
    "verify:season-2025": "node scripts/season-regression.mjs verify",
    "forecast:snapshot": "node scripts/generate-forecast-snapshot.mjs",
    "forecast:calibrate": "node scripts/calibrate-forecast.mjs",
    "participants:generate": "node scripts/generate-participant-directory.mjs",
    "participants:check": "node scripts/generate-participant-directory.mjs --check",
    "premypage": "npm run participants:check",
    "mypage": "ng build --base-href=https://fr-fantasy.ru/"
